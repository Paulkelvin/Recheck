# Neon serverless Postgres connection string
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack / Flutterwave
PAYSTACK_SECRET_KEY=
# Tier prices in kobo. Defaults: Quick Check 500000 (NGN 5,000), Full Report
# 1500000 (NGN 15,000).
PAYSTACK_QUICK_AMOUNT_KOBO=
PAYSTACK_FULL_AMOUNT_KOBO=

# SURCON scraper, used by the "Run automated check" button in
# /admin/surveyor-checks. Leave unset to keep Tier 1 manual-entry only (the
# button just fails over to the manual form). Only fill these in after a
# human has manually inspected accountsurcon.ng's markup -- SURCON's
# robots.txt disallows bots, so this stays a low-volume, admin-triggered
# lookup (see docs/design.md section 9), never scraped by an AI agent or
# run at any real volume.
#   SURCON_SEARCH_URL: the exact URL of SURCON's verification/search page
#     (starting point: https://www.accountsurcon.ng/)
#   SURCON_NAME_INPUT_SELECTOR: CSS selector for the search input
#   SURCON_SUBMIT_SELECTOR: CSS selector for the search/submit button
#   SURCON_RESULT_SELECTOR: CSS selector for the element the result text
#     appears in after searching
SURCON_SEARCH_URL=
SURCON_NAME_INPUT_SELECTOR=
SURCON_SUBMIT_SELECTOR=
SURCON_RESULT_SELECTOR=

# Only needed for local/self-hosted dev where Chromium is pre-installed at a
# fixed path -- skips the @sparticuz/chromium download used automatically on
# Vercel. Leave unset in production.
PLAYWRIGHT_CHROMIUM_PATH=

# WhatsApp Business Cloud API -- sends "your report is ready" to the buyer.
# NOT the same as the WhatsApp Business phone app: this needs its own setup
# in Meta's developer console (business.facebook.com):
#   1. Create a Meta app, add the "WhatsApp" product
#   2. Register/verify a sender phone number -> gives you the phone number ID
#   3. Generate a permanent access token (System User token) for that app
#   4. Create and get Meta's approval for a message template (Manage
#      Templates in WhatsApp Manager) with two body variables, e.g.:
#      "Hi {{1}}, your Land Scam Check report is ready. View it here: {{2}}"
#      -- WHATSAPP_TEMPLATE_REPORT_READY is that template's name
# Leave any of these unset to skip sending (logged, never blocks the report
# from being marked ready).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_REPORT_READY=
WHATSAPP_TEMPLATE_LANG=
