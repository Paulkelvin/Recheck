# Neon serverless Postgres connection string
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack / Flutterwave
PAYSTACK_SECRET_KEY=
# Report price in kobo. Defaults to 1500000 (NGN 15,000) if unset.
PAYSTACK_AMOUNT_KOBO=

# SURCON scraper (scripts/surcon-scan-worker.ts). Leave unset to keep Tier 1
# manual-entry only. Only fill these in after a human has manually inspected
# accountsurcon.ng's markup -- SURCON's robots.txt disallows bots, so this
# stays a low-volume, admin-triggered background job (see docs/design.md
# section 9), never scraped by an AI agent or run at any real volume.
SURCON_SEARCH_URL=
SURCON_NAME_INPUT_SELECTOR=
SURCON_SUBMIT_SELECTOR=
SURCON_RESULT_SELECTOR=
# Worker pacing (ms). Defaults: poll every 10s when idle, wait 5s between scans.
SURCON_WORKER_POLL_MS=
SURCON_WORKER_MIN_GAP_MS=
